#!/usr/bin/env bun
//
// ab-goal — agent-neutral goal front-end. Any agent (Claude Code via Bash, cron, a
// script) can hold one goal per context and share the same log as the pi /goal
// extension. State is file-based: ~/.agentBrain/goal-logs/<context>/current.json;
// the history is the shared ~/.agentBrain/goal-logs/<context>/goals.jsonl.
//
//   ab-goal set <condition>   [--original <raw>] [--context <slug>]
//   ab-goal status            [--context <slug>]
//   ab-goal met [reason]      [--context <slug>]   # achieved
//   ab-goal clear [reason]    [--context <slug>]   # stop early
//   ab-goal log [n]           [--context <slug>]
//
// The condition should already be SMART (verifiable). This CLI holds and logs it; the
// calling agent is responsible for the SMART/verify reasoning (it is the model).
import { execFileSync } from "node:child_process";
import { appendFileSync, existsSync, mkdirSync, readFileSync, unlinkSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { basename, dirname, join } from "node:path";
import { formatGoalLogEntry, type GoalLogEvent, goalLogPath, goalStatePath, type GoalState, pickContext } from "../lib/core";

function gitProject(): string | undefined {
	try {
		const top = execFileSync("git", ["rev-parse", "--show-toplevel"], { stdio: ["ignore", "pipe", "ignore"] }).toString().trim();
		return top ? basename(top) : undefined;
	} catch {
		return undefined;
	}
}

const baseDir = process.env.GOAL_LOG_DIR ?? join(homedir(), ".agentBrain", "goal-logs");

function readState(ctx: string): GoalState | undefined {
	try {
		return JSON.parse(readFileSync(goalStatePath(baseDir, ctx), "utf8")) as GoalState;
	} catch {
		return undefined;
	}
}
function writeState(ctx: string, goal: GoalState | undefined): void {
	const p = goalStatePath(baseDir, ctx);
	mkdirSync(dirname(p), { recursive: true });
	if (goal) writeFileSync(p, JSON.stringify(goal, null, 1));
	else if (existsSync(p)) unlinkSync(p);
}
function log(ctx: string, event: GoalLogEvent, fields: Record<string, unknown>): void {
	const p = goalLogPath(baseDir, ctx);
	mkdirSync(dirname(p), { recursive: true });
	appendFileSync(p, `${JSON.stringify(formatGoalLogEntry(event, { context: ctx, ...fields }, Date.now()))}\n`);
}

const argv = process.argv.slice(2);
let ctxArg: string | undefined;
let original: string | undefined;
for (const flag of ["--context", "--original"] as const) {
	const i = argv.indexOf(flag);
	if (i >= 0) {
		if (flag === "--context") ctxArg = argv[i + 1];
		else original = argv[i + 1];
		argv.splice(i, 2);
	}
}
const [cmd, ...rest] = argv;
const ctx = pickContext(ctxArg ?? process.env.GOAL_LOG_CONTEXT, gitProject());
const text = rest.join(" ").trim();

switch (cmd) {
	case "set": {
		if (!text) {
			console.error("usage: ab-goal set <condition>  (pass a SMART, verifiable condition)");
			process.exit(2);
		}
		writeState(ctx, { condition: text, iterations: 0, setAt: Date.now() });
		log(ctx, "set", { condition: text, ...(original ? { original } : {}) });
		console.log(`goal set [${ctx}]: ${text}`);
		break;
	}
	case "status": {
		const g = readState(ctx);
		console.log(g ? `goal [${ctx}]: ${g.condition}` : `no goal set [${ctx}]`);
		break;
	}
	case "met":
	case "done": {
		const g = readState(ctx);
		if (!g) {
			console.log(`no goal to complete [${ctx}]`);
			break;
		}
		writeState(ctx, undefined);
		log(ctx, "cleared", { condition: g.condition, outcome: "achieved", ...(text ? { reason: text } : {}) });
		console.log(`goal achieved [${ctx}]: ${g.condition}`);
		break;
	}
	case "clear": {
		const g = readState(ctx);
		writeState(ctx, undefined);
		if (g) log(ctx, "cleared", { condition: g.condition, outcome: "manual", ...(text ? { reason: text } : {}) });
		console.log(g ? `goal cleared [${ctx}]: ${g.condition}` : `no goal set [${ctx}]`);
		break;
	}
	case "log": {
		const n = Number.parseInt(rest[0] ?? "", 10);
		try {
			const lines = readFileSync(goalLogPath(baseDir, ctx), "utf8").trim().split("\n").filter(Boolean);
			for (const line of lines.slice(-(Number.isFinite(n) && n > 0 ? n : 10))) {
				try {
					const e = JSON.parse(line) as { iso?: string; event?: string; outcome?: string; condition?: string };
					console.log(`${e.iso ?? "?"}  ${e.event === "cleared" ? `cleared/${e.outcome ?? "?"}` : "set"}  ${e.condition ?? ""}`);
				} catch {
					console.log(line);
				}
			}
		} catch {
			console.log(`no goal log yet [${ctx}]`);
		}
		break;
	}
	default:
		console.log("usage: ab-goal set <condition> | status | met [reason] | clear [reason] | log [n]  [--context <slug>]");
		process.exit(cmd ? 2 : 0);
}
