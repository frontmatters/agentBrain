#!/usr/bin/env bash
# brain-poll — read events from agentBrain event-bus matching this agent.
# Spec refs: spec-cursor, spec-routing, spec-filesystem.

set -euo pipefail

usage() {
    cat <<'EOF'
brain-poll — read events from agentBrain event-bus

Required:
  --agent=<name>      who am I (filters via spec-routing matches_me)

Optional:
  --host=<name>       override hostname (default: hostname -s)
  --type=<glob>       filter by topic (shell glob, e.g. "peer-review.*")
  --correlation-id=<id>  only this conversation/thread
  --in-reply-to=<id>    only direct replies to this event
  --lookback=<dur>    scan window (default: 7d). Use Ns/Nm/Nh/Nd
  --commit            append yielded event_ids to seen-ids.set
  --all               include already-seen events (no dedup)
  --limit=<N>         max events to yield
  --raw               output only envelope JSON (default: adds _file)
  --summary           metadata-only NDJSON (broadcast: true when sent to everyone);
                      never payload/ref/host or commit
  --wait=<seconds>    rescan until a match or timeout (1..3600s); requires --summary
  --commit-id=<id>    mark exactly this event as read after inspecting it; no poll
  --help, -h          show this help

Env:
  AGENTBRAIN_DIR      brain checkout root (default: script-derived)

Output: NDJSON of matching events (oldest first), one per line.

Exit codes:
  0  success (may yield 0 events)
  1  missing/invalid arg
  4  filesystem error
  5  --wait timed out with no matching event
EOF
}

AGENTBRAIN_DIR="${AGENTBRAIN_DIR:-$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../../../.." && pwd)}"
# The vault through the resolver (AGENTBRAIN_VAULT and friends), never the
# checkout's own folder by assumption; a copy without scripts/lib (a test
# fixture) falls back to it.
if [ -f "$AGENTBRAIN_DIR/scripts/lib/vault.sh" ]; then
	# shellcheck source=/dev/null
	. "$AGENTBRAIN_DIR/scripts/lib/vault.sh"
else
	VAULT_DIR="${AGENTBRAIN_VAULT:-$AGENTBRAIN_DIR/vault}"
fi
HOST_NAME="$(hostname -s)"
AGENT_NAME=""
TYPE_GLOB=""
CORRELATION_ID=""
IN_REPLY_TO=""
LOOKBACK="7d"
COMMIT="false"
ALL="false"
LIMIT=""
RAW="false"
SUMMARY="false"
WAIT_SEC=""
COMMIT_ID=""

while [ $# -gt 0 ]; do
    case "$1" in
        --agent=*)          AGENT_NAME="${1#*=}" ;;
        --host=*)           HOST_NAME="${1#*=}" ;;
        --type=*)           TYPE_GLOB="${1#*=}" ;;
        --correlation-id=*) CORRELATION_ID="${1#*=}"; [ -n "$CORRELATION_ID" ] || { echo "brain-poll: empty --correlation-id" >&2; exit 1; } ;;
        --in-reply-to=*)    IN_REPLY_TO="${1#*=}"; [ -n "$IN_REPLY_TO" ] || { echo "brain-poll: empty --in-reply-to" >&2; exit 1; } ;;
        --lookback=*)       LOOKBACK="${1#*=}" ;;
        --commit)           COMMIT="true" ;;
        --all)              ALL="true" ;;
        --limit=*)          LIMIT="${1#*=}" ;;
        --raw)              RAW="true" ;;
        --summary)          SUMMARY="true" ;;
        --wait=*)            WAIT_SEC="${1#*=}"; [ -n "$WAIT_SEC" ] || { echo "brain-poll: empty --wait" >&2; exit 1; } ;;
        --commit-id=*)      COMMIT_ID="${1#*=}" ;;
        --help|-h)    usage; exit 0 ;;
        *) echo "brain-poll: unknown arg: $1" >&2; exit 1 ;;
    esac
    shift
done

[ -z "$AGENT_NAME" ] && { echo "brain-poll: --agent required" >&2; exit 1; }
if [ "$SUMMARY" = "true" ] && { [ "$COMMIT" = "true" ] || [ "$RAW" = "true" ]; }; then
    echo "brain-poll: --summary cannot be combined with --commit or --raw" >&2
    exit 1
fi
if [ -n "$WAIT_SEC" ]; then
    if ! [[ "$WAIT_SEC" =~ ^[1-9][0-9]*$ ]] || [ "$WAIT_SEC" -gt 3600 ]; then
        echo "brain-poll: --wait must be 1..3600 seconds" >&2; exit 1
    fi
    if [ "$SUMMARY" != "true" ] || [ "$COMMIT" = "true" ]; then
        echo "brain-poll: --wait requires --summary and cannot commit" >&2; exit 1
    fi
fi

# --commit-id: the read receipt. It marks one event the caller has actually
# inspected, and nothing else, so brain-status can report "read" truthfully.
# It refuses ids that do not exist or are not routed to this agent: marking
# someone else's mail as read would be a false receipt.
if [ -n "$COMMIT_ID" ]; then
    if ! [[ "$COMMIT_ID" =~ ^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$ ]]; then
        echo "brain-poll: --commit-id needs a full event id" >&2; exit 1
    fi
    if [ "$COMMIT" = "true" ] || [ "$SUMMARY" = "true" ] || [ -n "$WAIT_SEC" ] || [ -n "$CORRELATION_ID" ] || [ -n "$IN_REPLY_TO" ] || [ -n "$TYPE_GLOB" ]; then
        echo "brain-poll: --commit-id cannot be combined with other poll options" >&2; exit 1
    fi
fi

# Parse lookback (Ns/Nm/Nh/Nd) → seconds. Strict regex prevents silent fallthrough
# for malformed values like "-5d" or "10x".
parse_lookback() {
    local v="$1"
    if ! [[ "$v" =~ ^[1-9][0-9]*[smhd]$ ]]; then
        echo "brain-poll: invalid --lookback: $v (expected Ns/Nm/Nh/Nd, N≥1)" >&2
        exit 1
    fi
    local n="${v%[smhd]}"
    local unit="${v: -1}"
    case "$unit" in
        s) echo $((n)) ;;
        m) echo $((n * 60)) ;;
        h) echo $((n * 3600)) ;;
        d) echo $((n * 86400)) ;;
    esac
}
LOOKBACK_SEC="$(parse_lookback "$LOOKBACK")"

INBOX="${VAULT_DIR}/events/inbox"
ARCHIVE="${VAULT_DIR}/events/archive"
CURSOR_DIR="${VAULT_DIR}/events/cursors/$HOST_NAME/$AGENT_NAME"
mkdir -p "$CURSOR_DIR" || { echo "brain-poll: mkdir cursor failed" >&2; exit 4; }

SEEN_FILE="$CURSOR_DIR/seen-ids.set"
[ -f "$SEEN_FILE" ] || : > "$SEEN_FILE"

poll_once() {
# Refresh the window on every rescan: a long wait should not match newly
# expired events. Notification is not an ACK; cursor handling stays below.
local SCAN_START_TS
SCAN_START_TS="$(python3 -c "
from datetime import datetime, timedelta, timezone
t = datetime.now(timezone.utc) - timedelta(seconds=${LOOKBACK_SEC})
print(t.strftime('%Y%m%dT%H%M%S'))
")"
yielded=0
yielded_ids=()
# Build candidate file list (chronological via lex sort)
candidates=()
for d in "$INBOX" "$ARCHIVE"; do
    [ -d "$d" ] || continue
    while IFS= read -r f; do
        [ -n "$f" ] && candidates+=("$f")
    done < <(find "$d" -maxdepth 1 -name "*.json" ! -name "*.tmp" -type f 2>/dev/null | sort)
done

# ${a[@]+...}: bash 3.2 treats an empty array as unbound under set -u.
for f in ${candidates[@]+"${candidates[@]}"}; do
    # Parameter expansion, not basename: this runs once per file in the whole store,
    # BEFORE the window filter, so a subprocess each makes even a poll that matches
    # nothing slow on a large store.
    fname="${f##*/}"
    ts_part="${fname%%-*}"
    # Window filter (string compare on YYYYMMDDTHHMMSS prefix)
    [ "$ts_part" \< "$SCAN_START_TS" ] && continue

    # Parse envelope once
    if ! envelope="$(jq -c . "$f" 2>/dev/null)"; then
        echo "brain-poll: invalid JSON, skipping: $fname" >&2
        continue
    fi

    event_id="$(echo "$envelope" | jq -r '.event_id // empty')"
    [ -z "$event_id" ] && {
        echo "brain-poll: missing event_id, skipping: $fname" >&2
        continue
    }

    # Type-glob filter (if specified)
    if [ -n "$TYPE_GLOB" ]; then
        topic="$(echo "$envelope" | jq -r '.type // empty')"
        # shellcheck disable=SC2254
        case "$topic" in
            $TYPE_GLOB) ;;
            *) continue ;;
        esac
    fi

    # Exact thread filters: neither a name prefix nor a glob. Test both when
    # supplied; a direct reply can belong to a different conversation.
    if [ -n "$CORRELATION_ID" ] && [ "$(printf '%s\n' "$envelope" | jq -r '.correlation_id // empty')" != "$CORRELATION_ID" ]; then
        continue
    fi
    if [ -n "$IN_REPLY_TO" ] && [ "$(printf '%s\n' "$envelope" | jq -r '.in_reply_to // empty')" != "$IN_REPLY_TO" ]; then
        continue
    fi

    # Routing filter (matches_me per spec-routing)
    matches="$(echo "$envelope" | jq --arg agent "$AGENT_NAME" --arg host "$HOST_NAME" '
        if .to.broadcast == true then
            (.to.hosts | length == 0) or (.to.hosts | index($host) != null)
        else
            ((.to.agents | index($agent)) != null) and
            ((.to.hosts | length == 0) or (.to.hosts | index($host) != null))
        end
    ')"
    [ "$matches" != "true" ] && continue

    # Dedup against seen-ids
    if [ "$ALL" != "true" ] && grep -qxF "$event_id" "$SEEN_FILE" 2>/dev/null; then
        continue
    fi

    # Yield
    if [ "$SUMMARY" = "true" ]; then
        # Same-user processes can forge inbox files: even metadata fields are
        # untrusted. Restrict every returned value to bounded ASCII shapes.
        # A malformed field becomes a fixed sentinel, never copied verbatim.
        printf '%s\n' "$envelope" | jq -c '
            def safe($pattern; $max):
                if type == "string" and length <= $max and test($pattern)
                then . else "<invalid>" end;
            {
                event_id: (.event_id | safe("^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"; 36)),
                type: (.type | safe("^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){2}$"; 96)),
                from: ((.from | if type == "object" then .agent else null end) | safe("^[a-z0-9_-]{1,48}$"; 48)),
                timestamp: (.timestamp | safe("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"; 32)),
                correlation_id: (.correlation_id | safe("^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"; 36)),
                in_reply_to: (if .in_reply_to == null then null else .in_reply_to | safe("^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"; 36) end),
                broadcast: (.to.broadcast == true)
            }'
    elif [ "$RAW" = "true" ]; then
        echo "$envelope"
    else
        echo "$envelope" | jq -c --arg file "$fname" '. + {_file: $file}'
    fi
    yielded_ids+=("$event_id")
    yielded=$((yielded + 1))
    [ -n "$LIMIT" ] && [ "$yielded" -ge "$LIMIT" ] && break
done
return 0
}

if [ -n "$COMMIT_ID" ]; then
    commit_file=""
    for d in "$INBOX" "$ARCHIVE"; do
        [ -d "$d" ] || continue
        while IFS= read -r f; do
            if [ "$(jq -r '.event_id // empty' "$f" 2>/dev/null)" = "$COMMIT_ID" ]; then
                commit_file="$f"; break
            fi
        done < <(grep -lF "$COMMIT_ID" "$d"/*.json 2>/dev/null || true)
        [ -n "$commit_file" ] && break
    done
    [ -n "$commit_file" ] || { echo "brain-poll: no event $COMMIT_ID" >&2; exit 1; }
    routed="$(jq --arg id "$COMMIT_ID" --arg agent "$AGENT_NAME" --arg host "$HOST_NAME" '
        .event_id == $id and
        ((.to.hosts | length == 0) or (.to.hosts | index($host) != null)) and
        (.to.broadcast == true or ((.to.agents | index($agent)) != null))' "$commit_file" 2>/dev/null || echo false)"
    [ "$routed" = "true" ] || { echo "brain-poll: $COMMIT_ID is not routed to $AGENT_NAME" >&2; exit 1; }
    if grep -qxF "$COMMIT_ID" "$SEEN_FILE" 2>/dev/null; then exit 0; fi
    COMMIT="true"
    yielded_ids=("$COMMIT_ID")
elif [ -n "$WAIT_SEC" ]; then
    WAIT_START="$(date +%s)"
    while :; do
        poll_once
        [ "$yielded" -gt 0 ] && break
        if [ "$(($(date +%s) - WAIT_START))" -ge "$WAIT_SEC" ]; then exit 5; fi
        sleep 1
    done
else
    poll_once
fi

# Commit yielded IDs to seen-ids.set (atomic-rename, mkdir-locked).
# Lock: mkdir is atomic on POSIX, so it doubles as a cross-platform mutex.
# Two concurrent brain-poll --commit calls for the same cursor would otherwise lose
# IDs (each copies the file before the other appends).
if [ "$COMMIT" = "true" ] && [ "${#yielded_ids[@]}" -gt 0 ]; then
    LOCK_DIR="$SEEN_FILE.lock"
    LOCK_TIMEOUT=5
    LOCK_START="$(date +%s)"
    while ! mkdir "$LOCK_DIR" 2>/dev/null; do
        if [ "$(($(date +%s) - LOCK_START))" -ge "$LOCK_TIMEOUT" ]; then
            echo "brain-poll: lock timeout on $SEEN_FILE.lock (${LOCK_TIMEOUT}s)" >&2
            exit 4
        fi
        sleep 0.1
    done
    trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT

    TMP_SEEN="$SEEN_FILE.tmp.$$"
    cp "$SEEN_FILE" "$TMP_SEEN" || { echo "brain-poll: cursor write failed" >&2; exit 4; }
    for eid in "${yielded_ids[@]}"; do
        echo "$eid" >> "$TMP_SEEN"
    done
    mv "$TMP_SEEN" "$SEEN_FILE"

    rmdir "$LOCK_DIR" 2>/dev/null || true
    trap - EXIT
fi
