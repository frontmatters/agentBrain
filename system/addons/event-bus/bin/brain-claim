#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# brain-claim — record what this agent is about to work on.
#
# Implements SPEC-claims.md. A claim is an intention in words plus the paths it
# expects to touch, with an expiry. Two stores, as the spec requires: the claim
# file under vault/claims/ answers "what is held" by existing, and brain-emit
# writes the history to the event log.
#
# Usage:
#   brain-claim "intent" [--paths=a,b] [--ttl=4h] [--agent NAME]
#   brain-claim --release <id>
#
# Exit codes (from the spec, so a gate can use them without reading text):
#   0  recorded, nothing overlapped
#   3  recorded, but a claimed PATH overlaps an existing claim
#   2  usage error
#
# Intent is not compared: two phrasings of one intention often share no word,
# so the judgement stays with the reader (run brain-claims to see what is held).
set -uo pipefail

# realpath, not plain dirname: real scripts live under bin/ and a compat symlink
# elsewhere would make the climb land one level too high. See check-known-traps.
AGENTBRAIN_DIR="${AGENTBRAIN_DIR:-$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../../../.." && pwd)}"
# The vault through the resolver (AGENTBRAIN_VAULT and friends), never the
# checkout's own folder by assumption; a copy without scripts/lib (a test
# fixture) falls back to it.
if [ -f "$AGENTBRAIN_DIR/scripts/lib/vault.sh" ]; then
	# shellcheck source=/dev/null
	. "$AGENTBRAIN_DIR/scripts/lib/vault.sh"
else
	VAULT_DIR="${AGENTBRAIN_VAULT:-$AGENTBRAIN_DIR/vault}"
fi
CLAIMS_DIR="${VAULT_DIR}/claims"
CONFIG="${VAULT_DIR}/events/config.json"
HERE="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"

die() { echo "brain-claim: $1" >&2; exit "${2:-2}"; }

command -v jq >/dev/null 2>&1 || die "jq is required"
PYBIN="$(command -v python3 || command -v python)" || die "python3 is required"

# ── expiry: --ttl beats the config file beats the built-in ──────────────────
# Built-in stays 8 per the spec. A deployment that wants shorter says so in
# vault/events/config.json; nothing here hardcodes a site preference.
BUILTIN_HOURS=8
config_hours() {
	[ -f "$CONFIG" ] || return 1
	local v; v="$(jq -r '.claim_expiry_hours // empty' "$CONFIG" 2>/dev/null)" || return 1
	[ -n "$v" ] || return 1
	printf '%s' "$v"
}

# ttl_to_hours 4h|30m|2 -> hours as a decimal string
ttl_to_hours() {
	case "$1" in
		*h) printf '%s' "${1%h}" ;;
		*m) awk -v m="${1%m}" 'BEGIN{printf "%.6f", m/60}' ;;
		*)  printf '%s' "$1" ;;
	esac
}

# Identity is the SESSION, not the person. Two Claude Code sessions are the
# same agent and different sessions, and that is exactly the collision this
# addon exists for: two sessions on one machine, both running as the same
# user, committing to each other's branch. A claim naming the user would
# report them to themselves.
# Order: BRAIN_AGENT (explicit, and what a Pi agent or script sets) >
# the Claude Code session id, shortened > the user, as a last resort.
session_identity() {
	[ -n "${BRAIN_AGENT:-}" ] && { printf '%s' "$BRAIN_AGENT"; return; }
	if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
		printf 'session-%s' "$(printf '%s' "$CLAUDE_CODE_SESSION_ID" | tr -d '\n' | cut -c1-8)"
		return
	fi
	printf '%s' "${USER:-agent}"
}
INTENT=""; PATHS=""; TTL=""; AGENT="$(session_identity)"; RELEASE=""
while [ "$#" -gt 0 ]; do
	case "$1" in
		--release) RELEASE="${2:-}"; [ -n "$RELEASE" ] || die "--release needs an id"; shift 2 ;;
		--paths=*) PATHS="${1#--paths=}"; shift ;;
		--paths)   PATHS="${2:-}"; shift 2 ;;
		--ttl=*)   TTL="${1#--ttl=}"; shift ;;
		--ttl)     TTL="${2:-}"; shift 2 ;;
		--agent)   AGENT="${2:-}"; shift 2 ;;
		-h|--help) sed -n '3,20p' "$(realpath "${BASH_SOURCE[0]}")" | sed 's/^# \{0,1\}//'; exit 0 ;;
		-*)        die "unknown option: $1" ;;
		*)         [ -z "$INTENT" ] && INTENT="$1" || die "unexpected argument: $1"; shift ;;
	esac
done

mkdir -p "$CLAIMS_DIR" || die "cannot create $CLAIMS_DIR" 7
HOST_NAME="$(hostname -s 2>/dev/null || hostname)"

# emit <type> <claim-file>: write the history event for a claim.
# Broadcast, because the history is for whoever reads the log later, not for one
# recipient (SPEC-claims.md, "Two stores"). The payload is the claim record.
# Best-effort by contract: the claim file is the state and is already written or
# removed, so a failed emit never changes the exit code. It is not silent either:
# brain-emit's own message goes to stderr with a line saying what was lost.
emit() {
	local payload
	if [ ! -x "$HERE/brain-emit" ]; then
		echo "brain-claim: warning: $HERE/brain-emit not found; $1 not written to the event log" >&2
		return 0
	fi
	payload="$(jq -c . "$2" 2>/dev/null)" || {
		echo "brain-claim: warning: cannot read $2; $1 not written to the event log" >&2
		return 0
	}
	AGENTBRAIN_DIR="$AGENTBRAIN_DIR" "$HERE/brain-emit" --type="$1" --broadcast \
		--from="$AGENT" --payload="$payload" >/dev/null \
		|| echo "brain-claim: warning: brain-emit failed; $1 not written to the event log (the claim itself is unaffected)" >&2
	return 0
}

# ── release ─────────────────────────────────────────────────────────────────
if [ -n "$RELEASE" ]; then
	found=""
	for f in "$CLAIMS_DIR"/*.json; do
		[ -f "$f" ] || continue
		[ "$(jq -r .id "$f" 2>/dev/null)" = "$RELEASE" ] || continue
		found="$f"; break
	done
	[ -n "$found" ] || die "no claim with id $RELEASE" 1
	emit work.claim.released "$found"
	rm -f "$found"
	echo "released $RELEASE"
	exit 0
fi

[ -n "$INTENT" ] || die "an intent is required: brain-claim \"what you are about to do\""

HOURS="$TTL"
[ -n "$HOURS" ] && HOURS="$(ttl_to_hours "$HOURS")"
[ -n "$HOURS" ] || HOURS="$(config_hours || true)"
[ -n "$HOURS" ] || HOURS="$BUILTIN_HOURS"

# Both timestamps come from one source. `date -u +%6N` does NOT fail on BSD
# date: it prints the literal "6N", so a `||` fallback never fires and the
# record carries an unparseable time. Same shape as the stat -f trap that
# check-known-traps guards: the command succeeds and returns something else.
NOW="$("$PYBIN" -c 'import datetime;print(datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")+"Z")')"
[ -n "$NOW" ] || die "cannot compute current time" 7
EXPIRES="$(python3 - "$HOURS" <<'PY'
import sys, datetime
h = float(sys.argv[1])
t = datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(hours=h)
print(t.strftime("%Y-%m-%dT%H:%M:%S.%f") + "Z")
PY
)" || die "cannot compute expiry" 7

ID="$(python3 -c 'import uuid; print(uuid.uuid4().hex[:12])')"
# The repository is stored as a hash, never as the path. A claim file lives in
# the shared vault, which every checkout mounts, so a session working in a
# client repository would write that client's name into shared storage on
# every claim.
#
# Hashing costs nothing here, because this field is never shown. It is only
# ever compared: re-claim detection below, and `brain-claims --repo`. What the
# reader sees is `paths[]`, which is relative by construction.
# pwd -P, not pwd: the two branches have to yield the same kind of path or the
# hash below splits one directory into two identities. git prints the physical
# path; bare pwd prints the logical one and keeps whatever symlink you walked
# in through, so the same directory reached through a symlink and directly
# hashes differently with pwd and identically with pwd -P. Two sessions in the
# same non-git directory would otherwise not see each other's claim.
REPO_PATH="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
REPO="$(printf '%s' "$REPO_PATH" | shasum -a 256 | cut -c1-16)"
BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
# ── re-claim: extend instead of duplicating ────────────────────────────────
# Same agent, intent and repo extends the existing claim, so the expiry
# measures time since the last claim, not since the session started.
for _f in "$CLAIMS_DIR"/*.json; do
	[ -f "$_f" ] || continue
	[ "$(jq -r .agent "$_f" 2>/dev/null)" = "$AGENT" ] || continue
	[ "$(jq -r .intent "$_f" 2>/dev/null)" = "$INTENT" ] || continue
	[ "$(jq -r .repo "$_f" 2>/dev/null)" = "$REPO" ] || continue
	_new="$(jq --arg e "$EXPIRES" '.expires_at = $e' "$_f")" || break
	printf '%s' "$_new" > "$_f.tmp" && mv "$_f.tmp" "$_f" || break
	jq -r .id "$_f"
	exit 0
done

# ── collisions, before writing ──────────────────────────────────────────────
# Path overlap is prefix-based in both directions: claiming scripts/ warns
# against a held scripts/run-gates.mjs, and the other way round.
PATH_HIT=0
if [ -n "$PATHS" ]; then
	IFS=',' read -r -a want <<< "$PATHS"
	for f in "$CLAIMS_DIR"/*.json; do
		[ -f "$f" ] || continue
		exp="$(jq -r .expires_at "$f" 2>/dev/null)"; [ -n "$exp" ] || continue
		[[ "$exp" > "$NOW" ]] || continue                    # expired: not held
		[ "$(jq -r .repo "$f" 2>/dev/null)" = "$REPO" ] || continue
		while IFS= read -r held; do
			[ -n "$held" ] || continue
			for w in "${want[@]}"; do
				case "$held" in "$w"*) : ;; *) case "$w" in "$held"*) : ;; *) continue ;; esac ;; esac
				printf 'brain-claim: path overlap: %s is held by %s (%s)\n' \
					"$held" "$(jq -r .agent "$f")" "$(jq -r .intent "$f")" >&2
				PATH_HIT=1
			done
		done < <(jq -r '.paths[]?' "$f" 2>/dev/null)
	done
fi

TMP="$(mktemp "$CLAIMS_DIR/.tmp.XXXXXX")" || die "cannot create temp file" 7
trap 'rm -f "$TMP"' EXIT
jq -n --arg id "$ID" --arg agent "$AGENT" --arg host "$HOST_NAME" \
      --arg intent "$INTENT" --arg repo "$REPO" --arg branch "$BRANCH" \
      --arg taken "$NOW" --arg expires "$EXPIRES" --arg paths "$PATHS" \
  '{id:$id, agent:$agent, host:$host, intent:$intent,
    paths: ($paths | if . == "" then [] else split(",") end),
    repo:$repo, branch:$branch, taken_at:$taken, expires_at:$expires}' > "$TMP" \
  || die "cannot write claim" 7
FINAL="$CLAIMS_DIR/${HOST_NAME}-${AGENT}-${ID}.json"
mv "$TMP" "$FINAL" || die "atomic rename failed" 7
trap - EXIT

emit work.claim.taken "$FINAL"
echo "$ID"
[ "$PATH_HIT" -eq 1 ] && exit 3
exit 0
