<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  agentBrain LAN git daemon: exposes the dev checkout as
      git://<this-lan-ip>/agentBrain-dev
  so installs done via the LAN bundle keep a working origin for updates/pulls,
  also on machines that cannot reach the primary git remote.

  Only repos containing a git-daemon-export-ok file at their root are exported;
  without --export-all everything else under {{HOME}}/Developer stays private.
  Foreground process on purpose: launchd supervises it and KeepAlive restarts
  it if it dies, so "updates enabled when reachable" stays true.
  git is looked up via PATH (Homebrew first, then the system git).
  Manual fire: launchctl kickstart -k gui/$UID/dev.agentbrain.git-daemon
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.agentbrain.git-daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <string>git</string>
        <string>daemon</string>
        <string>--base-path={{HOME}}/Developer</string>
        <string>--reuseaddr</string>
        <string>--informative-errors</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>{{VAULT}}/vault/logs/git-daemon.out.log</string>
    <key>StandardErrorPath</key>
    <string>{{VAULT}}/vault/logs/git-daemon.err.log</string>
</dict>
</plist>
