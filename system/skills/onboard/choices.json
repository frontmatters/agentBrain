{
  "$comment": "Canonical fixed-choice sets for /onboard intake (G5). Every option is {value, desc} — the desc IS shown to the user (self-explaining options). The language question is asked in English (askedIn) with each desc in that option's own language; artifactLanguage replaces the old unclear 'Mixed'. locales.supported must equal the scripts/lib/_strings.sh normalize case (G6).",
  "fields": {
    "language": {
      "type": "choice", "file": "communication.md", "askedIn": "en", "derivesLocale": true,
      "options": [
        { "value": "English",    "desc": "conversation + UI scripts in English" },
        { "value": "Nederlands", "desc": "gesprek + UI-scripts in het Nederlands" },
        { "value": "Deutsch",    "desc": "Unterhaltung auf Deutsch (UI-Skripte → en)" },
        { "value": "Français",   "desc": "conversation en français (scripts UI → en)" },
        { "value": "Español",    "desc": "conversación en español (scripts UI → en)" },
        { "value": "中文",        "desc": "对话使用中文（界面脚本 → en）" },
        { "value": "日本語",      "desc": "日本語で会話（UIスクリプト → en）" }
      ]
    },
    "artifactLanguage": {
      "type": "choice", "file": "communication.md",
      "condition": { "field": "language", "not": "English" },
      "options": [
        { "value": "english-artifacts", "desc": "chat in your language; code, commits & docs in English (recommended — common in most ecosystems)" },
        { "value": "same-language",     "desc": "EVERYTHING in your language — also commit messages, code comments and docs" }
      ]
    },
    "verbosity": {
      "type": "choice", "file": "communication.md",
      "options": [
        { "value": "concise",          "desc": "short answers, minimal explanation" },
        { "value": "detailed",         "desc": "thorough explanations" },
        { "value": "depends on topic", "desc": "the agent judges per topic" }
      ]
    },
    "askFirst": {
      "type": "choice", "file": "communication.md",
      "options": [
        { "value": "ask before acting",      "desc": "confirm every non-trivial action" },
        { "value": "just do trivial things", "desc": "small things directly; big things are asked" }
      ]
    },
    "autonomy": {
      "type": "choice", "file": "workflow.md",
      "options": [
        { "value": "ask often",         "desc": "check in frequently before acting" },
        { "value": "only for blockers", "desc": "keep going, ask only when truly stuck" },
        { "value": "full autonomy",     "desc": "run the whole task without interrupting" }
      ]
    },
    "design": {
      "type": "choice", "file": "design-philosophy.md",
      "options": [
        { "value": "dark",  "desc": "dark as default for generated UI" },
        { "value": "light", "desc": "light as default" },
        { "value": "both",  "desc": "follow the system / offer a toggle" }
      ]
    },
    "decision": {
      "type": "choice", "file": "decision-making.md",
      "options": [
        { "value": "pragmatic", "desc": "simplest thing that works wins" },
        { "value": "thorough",  "desc": "weigh options carefully first" },
        { "value": "move fast", "desc": "ship, then iterate" }
      ]
    },
    "channel": {
      "type": "choice",
      "options": [
        { "value": "stable",     "desc": "only finished releases — second machines, clients" },
        { "value": "prerelease", "desc": "early access" },
        { "value": "edge",       "desc": "bleeding edge (untagged main) — dev machines" }
      ]
    },
    "updateMode": {
      "type": "choice",
      "options": [
        { "value": "ask",    "desc": "prompt when an update is available" },
        { "value": "notify", "desc": "only mention it at session start" },
        { "value": "auto",   "desc": "update automatically behind the doctor gate (rolls back on failure)" },
        { "value": "off",    "desc": "manual only" }
      ]
    },
    "scope": {
      "type": "choice",
      "options": [
        { "value": "personal only",                    "desc": "individual use — most users" },
        { "value": "personal + organization",          "desc": "also org-wide rules under organization/" },
        { "value": "personal + organization + team",   "desc": "plus team agreements under team/" }
      ]
    },
    "os":        { "type": "text", "file": "tech-stack.md" },
    "editor":    { "type": "text", "file": "tech-stack.md" },
    "languages": { "type": "text", "file": "tech-stack.md" },
    "hosting":   { "type": "text", "file": "tech-stack.md" }
  },
  "locales": {
    "supported": ["en", "nl"],
    "note": "Single source: scripts/lib/_strings.sh normalize case. An unsupported code -> notice + fallback en (never a blocking question); /add-locale adds it later."
  }
}
