#!/usr/bin/env bash
# pre-push — fast doctor gate before sharing commits.
#
# Runs `doctor.sh --fast` (the cheap, high-signal structural + privacy checks +
# bash syntax) so the safe path is also the fast path — no reflex to bypass it.
# The slow checks (TypeScript pi-extension checks, the test suites, shellcheck)
# run in the FULL doctor, which still gates release-check, deploy's
# validate-install sandbox, and CI. Set PUSH_FULL_DOCTOR=1 to run the full
# doctor here too.
#
# The doctor runs over the COMMIT BEING PUSHED, in a temporary worktree, not
# over the working tree of this checkout. The working tree keeps moving while
# the doctor runs (a commit from another session, an edit, an addon in
# progress): twice in two days the doctor saw HEAD change under it, blamed the
# check that was running and refused the push, and what it had validated was
# not what the push carried. A detached worktree of the pushed sha is exactly
# the push, and nothing else touches it. The vault link and brain.json are
# not tracked; they are put in place so the checks that read the vault work.
#
# Skip-escape: PUSH_SKIP_DOCTOR=1 git push … (use sparingly).
set -euo pipefail
if [[ "${PUSH_SKIP_DOCTOR:-0}" = "1" ]]; then
  echo "pre-push: PUSH_SKIP_DOCTOR=1 set — skipping doctor.sh" >&2
  exit 0
fi
[[ -x scripts/doctor.sh ]] || exit 0
# The post-commit auto-push runs `git push` from inside a hook, and git's hook
# environment (GIT_DIR, GIT_INDEX_FILE, GIT_PREFIX) leaks into this one: with
# GIT_DIR set, `git worktree add` and every git command the doctor runs in the
# worktree address the main checkout instead. Drop them; this hook only needs
# the repository it runs in.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX

# The sha being pushed: git hands "<local ref> <local sha> <remote ref> <remote sha>"
# per ref on stdin. A delete pushes the null sha: nothing to validate.
push_sha=""; refs_seen=0
while read -r _lref lsha _rref _rsha; do
  [[ -n "$lsha" ]] || continue
  refs_seen=1
  [[ "$lsha" != *[!0]* ]] && continue   # the null sha: a ref delete
  push_sha="$lsha"
done
if [[ -z "$push_sha" ]]; then
  if [[ "$refs_seen" -eq 1 ]]; then
    echo "pre-push: only ref deletes; nothing to validate" >&2
    exit 0
  fi
  push_sha="$(git rev-parse HEAD)"   # run by hand, no refs on stdin
fi

if [[ "${PUSH_FULL_DOCTOR:-0}" = "1" ]]; then
  DOCTOR_ARGS=""; echo "pre-push: running FULL doctor.sh (PUSH_FULL_DOCTOR=1)" >&2
else
  DOCTOR_ARGS="--fast"; echo "pre-push: running doctor.sh --fast (full doctor runs in release-check/deploy/CI)" >&2
fi

# A detached worktree of the pushed commit. When that cannot be made (a shallow
# clone without the object, a filesystem that refuses), the doctor runs in
# place as before and says so.
run_dir="."
wt=""
cleanup() {
  if [[ -n "$wt" ]]; then
    git worktree remove --force "$wt" >/dev/null 2>&1 || rm -rf "$wt"
    git worktree prune >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT
wt="$(mktemp -d -t agentbrain-prepush.XXXXXX)"
if wt_err="$(git worktree add --detach -q "$wt" "$push_sha" 2>&1)"; then
  # Untracked state the checks need: the vault link and the machine's brain.json.
  if [[ -L vault ]]; then ln -s "$(readlink vault)" "$wt/vault"; fi
  [[ -f brain.json ]] && cp brain.json "$wt/brain.json"
  run_dir="$wt"
  echo "pre-push: validating $(git rev-parse --short "$push_sha") in a detached worktree" >&2
else
  rm -rf "$wt"; wt=""
  echo "pre-push: no worktree for $(git rev-parse --short "$push_sha") (${wt_err:-no reason given}); validating the working tree in place" >&2
fi

# Concurrent runs are serialized by doctor itself (scripts/lib/lock.sh), so a
# push racing the post-commit auto-push, or a manual doctor, waits its turn.
log="$(mktemp -t agentbrain-doctor-prepush.XXXXXX)"
# shellcheck disable=SC2086
if ! (cd "$run_dir" && bash scripts/doctor.sh $DOCTOR_ARGS) >"$log" 2>&1; then
  echo "" >&2
  echo "✗ pre-push BLOCKED: doctor.sh failed. Last 30 lines:" >&2
  tail -30 "$log" >&2
  echo "" >&2
  echo "Full log: $log" >&2
  echo "Bypass (use sparingly): PUSH_SKIP_DOCTOR=1 git push …" >&2
  exit 1
fi
rm -f "$log"
echo "pre-push: doctor.sh passed." >&2
